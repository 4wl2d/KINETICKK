{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetickk.local/contracts/android-gameplay-flow-v1.schema.json",
  "title": "KINETICKK Android selector gameplay flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "name", "measurementStartStep", "steps"],
  "properties": {
    "$schema": {
      "const": "android_gameplay_flow.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "measurementStartStep": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/waitStep"
          },
          {
            "$ref": "#/$defs/tapStep"
          },
          {
            "$ref": "#/$defs/longPressStep"
          },
          {
            "$ref": "#/$defs/sleepStep"
          }
        ]
      }
    }
  },
  "$defs": {
    "selectorLeaf": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "contentDescription": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "clickable": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/selectorLeaf"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anyOf"],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/selectorLeaf"
              }
            }
          }
        }
      ]
    },
    "selectorStepProperties": {
      "selector": {
        "$ref": "#/$defs/selector"
      },
      "timeoutMillis": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60000
      },
      "repeat": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "intervalMillis": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "waitStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "selector"],
      "properties": {
        "action": {
          "const": "wait"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "timeoutMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "intervalMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "tapStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "selector"],
      "properties": {
        "action": {
          "const": "tap"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "timeoutMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "intervalMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "reusePreviousHierarchy": {
          "type": "boolean"
        }
      }
    },
    "longPressStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "selector", "durationMillis"],
      "properties": {
        "action": {
          "const": "longPress"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "timeoutMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "intervalMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "reusePreviousHierarchy": {
          "type": "boolean"
        }
      }
    },
    "sleepStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "durationMillis"],
      "properties": {
        "action": {
          "const": "sleep"
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "intervalMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
