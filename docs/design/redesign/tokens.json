 "typography": {
  "families": {
   "wide": "Unbounded",
   "cond": "Sofia Sans Extra Condensed",
   "body": "Sofia Sans Semi Condensed",
   "mono": "Martian Mono"
  },
  "fontFiles": {
   "wide 900": "kk_wide_black.ttf",
   "wide 700": "kk_wide_bold.ttf",
   "cond 900 italic": "kk_cond_black_italic.ttf",
   "cond 900": "kk_cond_black.ttf",
   "cond 800": "kk_cond_extrabold.ttf",
   "body 400": "kk_body_regular.ttf",
   "body 500": "kk_body_medium.ttf",
   "body 700": "kk_body_bold.ttf",
   "mono 500": "kk_mono_medium.ttf",
   "mono 700": "kk_mono_bold.ttf"
  },
  "roles": {
   "t-wide": {
    "family": "wide",
    "weight": 900,
    "case": "upper",
    "tracking": 0,
    "lineHeight": 0.9,
    "use": "clock, titles, big numerals, speed readout"
   },
   "t-cond": {
    "family": "cond",
    "weight": 900,
    "italic": true,
    "case": "upper",
    "tracking": "0.005em",
    "lineHeight": 0.86,
    "use": "menus, buttons, headings, callouts, damage numbers"
   },
   "t-label": {
    "family": "cond",
    "weight": 800,
    "case": "upper",
    "tracking": "0.09em",
    "size": 15,
    "lineHeight": 1,
    "use": "labels, tabs, tags"
   },
   "t-body": {
    "family": "body",
    "weight": 400,
    "size": 16,
    "lineHeight": 1.4,
    "use": "descriptions, tooltips"
   },
   "t-mono": {
    "family": "mono",
    "weight": 500,
    "case": "upper",
    "tracking": "0.05em",
    "size": 11,
    "lineHeight": 1.35,
    "use": "instrument readouts, small data"
   },
   "t-num": "tabular figures (font feature tnum) for every changing number"
  },
  "scale": {
   "display": "wide 900, 96-160 / 0.9",
   "title": "cond 900i, 56-72 / 0.86",
   "heading": "cond 900i, 26-40",
   "label": "cond 800, 15, +9%",
   "body": "semi 400, 16 / 1.4",
   "data": "mono 500, 11, +5%",
   "minPhoneText": 14
  }
 },
 "shape": {
  "shear": "-12deg (skewX) on panels, meters, pips, buttons",
  "slash": "-27.5deg for cuts, wipes, shutters",
  "cut": "slabs are parallelograms with 9-22px horizontal cut; chamfer panels cut one corner (--cut 14px)",
  "echo": "selected/primary slabs have a second slab behind, offset (10px,10px) in volt (or rarity color)",
  "stroke": "hairlines 1-1.5px line/line-2; icons 2px"
 },
 "easing": {
  "pull": [
   0.18,
   1.45,
   0.4,
   1
  ],
  "snap": [
   0.75,
   0,
   0.2,
   1
  ],
  "out": [
   0.16,
   1,
   0.3,
   1
  ],
  "in": [
   0.6,
   0,
   0.9,
   0.4
  ],
  "use": {
   "pull": "selection slabs, cards, slams (overshoot)",
   "snap": "shutters, wipes, tab swaps",
   "out": "entrances, number drift, meters filling",
   "in": "exits, warnings closing in"
  }
 },
 "duration_ms": {
  "impact": 16,
  "snap": 90,
  "pull": 220,
  "shutter": 420,
  "drift": 600,
  "ambientMin": 24000
 },
